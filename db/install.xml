<?xml version="1.0" ?>
<XMLDB xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" PATH="local/dutydesk/db" VERSION="2026072800" COMMENT="DutyDesk install structure" xsi:noNamespaceSchemaLocation="../../lib/xmldb/xmldb.xsd">
    <TABLES>
        <TABLE NAME="local_dutydesk_department" COMMENT="Departments and organisational units">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" NOTNULL="true" LENGTH="10" SEQUENCE="true"/>
                <FIELD NAME="name" TYPE="char" NOTNULL="true" LENGTH="255"/>
                <FIELD NAME="description" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="timestamp" TYPE="int" NOTNULL="true" LENGTH="10"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_dutydesk_deptmgr" COMMENT="Department manager assignments">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" NOTNULL="true" LENGTH="10" SEQUENCE="true"/>
                <FIELD NAME="departmentid" TYPE="int" NOTNULL="true" LENGTH="10"/>
                <FIELD NAME="userid" TYPE="int" NOTNULL="true" LENGTH="10"/>
                <FIELD NAME="assignedby" TYPE="int" NOTNULL="true" LENGTH="10"/>
                <FIELD NAME="timecreated" TYPE="int" NOTNULL="true" LENGTH="10"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="deptuseruniq" TYPE="unique" FIELDS="departmentid, userid"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_dutydesk_position" COMMENT="Positions in the duty plan">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" NOTNULL="true" LENGTH="10" SEQUENCE="true"/>
                <FIELD NAME="title" TYPE="char" NOTNULL="true" LENGTH="255"/>
                <FIELD NAME="positiontype" TYPE="char" NOTNULL="true" LENGTH="20" DEFAULT="position"/>
                <FIELD NAME="departmentid" TYPE="int" NOTNULL="true" LENGTH="10"/>
                <FIELD NAME="description" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="primaryuserid" TYPE="int" NOTNULL="false" LENGTH="10"/>
                <FIELD NAME="archived" TYPE="int" NOTNULL="false" LENGTH="1"/>
                <FIELD NAME="archivedtime" TYPE="int" NOTNULL="false" LENGTH="10"/>
                <FIELD NAME="isvacant" TYPE="int" NOTNULL="true" LENGTH="1" DEFAULT="0"/>
                <FIELD NAME="timestamp" TYPE="int" NOTNULL="true" LENGTH="10"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_dutydesk_userinfo" COMMENT="Additional user assignment information">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" NOTNULL="true" LENGTH="10" SEQUENCE="true"/>
                <FIELD NAME="userid" TYPE="int" NOTNULL="true" LENGTH="10"/>
                <FIELD NAME="departmentid" TYPE="int" NOTNULL="true" LENGTH="10"/>
                <FIELD NAME="positionid" TYPE="int" NOTNULL="true" LENGTH="10"/>
                <FIELD NAME="dutydeskrole" TYPE="char" NOTNULL="false" LENGTH="100"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_dutydesk_task" COMMENT="Tasks assigned to positions">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" NOTNULL="true" LENGTH="10" SEQUENCE="true"/>
                <FIELD NAME="title" TYPE="char" NOTNULL="true" LENGTH="255"/>
                <FIELD NAME="description" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="descriptionformat" TYPE="int" NOTNULL="true" LENGTH="2" DEFAULT="1"/>
                <FIELD NAME="categoryid" TYPE="int" NOTNULL="false" LENGTH="10"/>
                <FIELD NAME="weight" TYPE="int" NOTNULL="false" LENGTH="3"/>
                <FIELD NAME="active" TYPE="int" NOTNULL="true" LENGTH="1" DEFAULT="0"/>
                <FIELD NAME="timestamp" TYPE="int" NOTNULL="true" LENGTH="10"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_dutydesk_subtask" COMMENT="Subtasks belonging to tasks">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" NOTNULL="true" LENGTH="10" SEQUENCE="true"/>
                <FIELD NAME="taskid" TYPE="int" NOTNULL="true" LENGTH="10"/>
                <FIELD NAME="title" TYPE="char" NOTNULL="true" LENGTH="255"/>
                <FIELD NAME="description" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="descriptionformat" TYPE="int" NOTNULL="true" DEFAULT="1" LENGTH="2"/>
                <FIELD NAME="sortorder" TYPE="int" NOTNULL="false" LENGTH="10"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_dutydesk_taskassign" COMMENT="Task assignments to positions">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" NOTNULL="true" LENGTH="10" SEQUENCE="true"/>
                <FIELD NAME="taskid" TYPE="int" NOTNULL="true" LENGTH="10"/>
                <FIELD NAME="positionid" TYPE="int" NOTNULL="true" LENGTH="10"/>
                <FIELD NAME="workloadpercent" TYPE="int" NOTNULL="false" LENGTH="3"/>
                <FIELD NAME="assignedby" TYPE="int" NOTNULL="true" LENGTH="10"/>
                <FIELD NAME="timestamp" TYPE="int" NOTNULL="true" LENGTH="10"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_dutydesk_posdeputy" COMMENT="Deputy assignments for positions">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" NOTNULL="true" LENGTH="10" SEQUENCE="true"/>
                <FIELD NAME="positionid" TYPE="int" NOTNULL="true" LENGTH="10"/>
                <FIELD NAME="userid" TYPE="int" NOTNULL="true" LENGTH="10"/>
                <FIELD NAME="assignedby" TYPE="int" NOTNULL="true" LENGTH="10"/>
                <FIELD NAME="timecreated" TYPE="int" NOTNULL="true" LENGTH="10" DEFAULT="0"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="uniqposition" TYPE="unique" FIELDS="positionid"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_dutydesk_category" COMMENT="Task categories">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" NOTNULL="true" LENGTH="10" SEQUENCE="true"/>
                <FIELD NAME="name" TYPE="char" NOTNULL="true" LENGTH="255"/>
                <FIELD NAME="departmentid" TYPE="int" NOTNULL="false" LENGTH="10"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_dutydesk_comment" COMMENT="Comments on tasks and training items">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" NOTNULL="true" LENGTH="10" SEQUENCE="true"/>
                <FIELD NAME="userid" TYPE="int" NOTNULL="true" LENGTH="10"/>
                <FIELD NAME="content" TYPE="text" NOTNULL="true"/>
                <FIELD NAME="created" TYPE="int" NOTNULL="true" LENGTH="10"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_dutydesk_import" COMMENT="Task import metadata">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" NOTNULL="true" LENGTH="10" SEQUENCE="true"/>
                <FIELD NAME="filename" TYPE="char" NOTNULL="true" LENGTH="255"/>
                <FIELD NAME="importedby" TYPE="int" NOTNULL="true" LENGTH="10"/>
                <FIELD NAME="created" TYPE="int" NOTNULL="true" LENGTH="10"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="local_dutydesk_taskhist" COMMENT="Task change history">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" NOTNULL="true" LENGTH="10" SEQUENCE="true"/>
                <FIELD NAME="taskid" TYPE="int" NOTNULL="true" LENGTH="10"/>
                <FIELD NAME="userid" TYPE="int" NOTNULL="false" LENGTH="10"/>
                <FIELD NAME="action" TYPE="char" NOTNULL="true" LENGTH="50"/>
                <FIELD NAME="details" TYPE="text" NOTNULL="false"/>
                <FIELD NAME="timecreated" TYPE="int" NOTNULL="true" LENGTH="10"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="taskidx" UNIQUE="false" FIELDS="taskid"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
